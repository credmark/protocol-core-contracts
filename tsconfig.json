{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "typeRoots": [
      "./typechain-types",
      "./node_modules/@types"
    ],
    "types": [
      "@nomicfoundation/hardhat-ethers",
      "@nomicfoundation/hardhat-chai-matchers",
      "@types/mocha"
    ],
    "skipLibCheck": true
  },
  "include": [
    "./test",
    "./scripts"
